+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+)
+
+// Deliberate false primary/verifier outputs for gateway regression only. These
+// synthetic markers are never part of the production classifier or rules.
+func mockAccuracyVerification(w http.ResponseWriter, request chatRequest, text string) bool {
+	if !strings.Contains(text, "accuracy-fixture-") {
+		return false
+	}
+	var doc struct {
+		RequestText string `json:"request_text"`
+	}
+	if json.Unmarshal([]byte(text), &doc) != nil {
+		return false
+	}
+	evidence := "/workspace/magisk/install_magisk.sh"
+	if strings.Contains(text, "accuracy-fixture-search") {
+		at := strings.Index(doc.RequestText, "rg -n")
+		if at < 0 {
+			return false
+		}
+		evidence = strings.SplitN(doc.RequestText[at:], "\n", 2)[0]
+	}
+	system := messageText(request)
+	correction := strings.Contains(system, "OPERATION GROUNDING CHECK")
+	deny := strings.Contains(system, "CYBER DENY SECOND PASS") && !correction
+	if strings.Contains(text, "accuracy-fixture-unresolved") && correction {
+		deny = true
+	}
+	if deny {
+		writeStrictCyberFixture(w, evidence, "synthetic mistaken association from passive evidence")
+		return true
+	}
+	content, _ := json.Marshal(map[string]any{"decision": "allow", "risk_code": "", "category": "ordinary_analysis", "confidence": .99, "reason": "synthetic classification control", "evidence": ""})
+	writeJSON(w, 200, map[string]any{"choices": []any{map[string]any{"finish_reason": "stop", "message": map[string]any{"content": string(content)}}}})
+	return true
+}
