diff --git a/internal/platform/audit_coverage_details.go b/internal/platform/audit_coverage_details.go
new file mode 100644
index 0000000..b7e8f7a
--- /dev/null
+++ b/internal/platform/audit_coverage_details.go
@@ -0,0 +1,28 @@
+package platform
+
+import "regexp"
+
+// Location/type metadata only; never includes message text, tool results,
+// media URLs, secrets, arbitrary object keys or raw request bodies.
+type AuditCoverageDetail struct {
+	Issue       string `json:"issue"`
+	Path        string `json:"path"`
+	Role        string `json:"role"`
+	ContentType string `json:"content_type"`
+}
+
+var auditDiagnosticTypeName = regexp.MustCompile(`^[a-z][a-z0-9_]{0,47}$`)
+
+func (x *AuditTextExtraction) addCoverageDetail(issue, path, role, kind string) {
+	x.addCoverageIssue(issue)
+	if len(x.CoverageDetails) >= 32 {
+		return
+	}
+	if !auditDiagnosticTypeName.MatchString(kind) {
+		kind = "unknown"
+	}
+	if len(path) > 512 {
+		path = "structure_depth_limit"
+	}
+	x.CoverageDetails = append(x.CoverageDetails, AuditCoverageDetail{Issue: issue, Path: path, Role: role, ContentType: kind})
+}
